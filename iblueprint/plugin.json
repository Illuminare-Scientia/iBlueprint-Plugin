{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "iblueprint",
  "version": "0.1.0",
  "description": "Find, inspect, run, and safely edit iBlueprint Blueprints from ChatGPT, Codex, and GitHub Copilot.",
  "author": {
    "name": "Illuminare Scientia",
    "url": "https://iblueprint.ai"
  },
  "homepage": "https://iblueprint.ai",
  "repository": "https://github.com/Illuminare-Scientia/iBlueprint-Plugin",
  "license": "MIT",
  "keywords": [
    "iblueprint",
    "blueprints",
    "workflows",
    "automation"
  ],
  "extensions": {
    "com.openai": {
      "onboardingSkill": "./skills/setup/SKILL.md",
      "interface": {
        "displayName": "iBlueprint",
        "shortDescription": "Run and design AI workflows",
        "longDescription": "Connect your iBlueprint account to find authorized Blueprints, inspect their inputs, run workflows on request, review results, and propose safely validated edits.",
        "developerName": "Illuminare Scientia",
        "category": "Productivity",
        "capabilities": [
          "Read",
          "Write"
        ],
        "websiteURL": "https://iblueprint.ai",
        "supportURL": "https://iblueprint.ai/support",
        "privacyPolicyURL": "https://iblueprint.ai/privacy",
        "termsOfServiceURL": "https://iblueprint.ai/terms",
        "composerIcon": "./assets/icon.png",
        "logo": "./assets/icon.png",
        "defaultPrompt": [
          "Find the iBlueprint workflow I use for weekly reporting.",
          "Show the required inputs for my customer onboarding Blueprint.",
          "Explain why my latest iBlueprint run failed."
        ]
      }
    }
  }
}
